# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://techpublisher.vercel.app

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Credentials (never expose to client-side bundles)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# HMAC Signing Secret for 2-step redeem token generation (min 32 characters)
REDEEM_SECRET=your-random-32-character-secret-key-change-in-production

# Google Analytics 4 Measurement ID (optional: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console Verification Token (optional meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense Configuration (optional)
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

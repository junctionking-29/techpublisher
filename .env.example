# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Credentials (never expose to client-side bundles)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# HMAC Signing Secret for 2-step redeem token generation (min 32 characters recommended)
REDEEM_SECRET=your-random-32-character-secret-key-change-in-production

# Advertising Feature Flag (true | false)
NEXT_PUBLIC_ADS_ENABLED=false
